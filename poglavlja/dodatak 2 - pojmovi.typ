// Овде пишете објашњење најважнијих појмова које сте користили у тексту

#import "../funkcije.typ": dodatak

// Због аутоматског бројања сваки додатак мора имати лабелу са префиксом
// dodatak- као у наслову испод.
= Списак коришћених појмова <dodatak-2>

#dodatak(
    table(
        [*Појам*], [*Објашњење*],
        [_Access_ токен], [Краткотрајан JWT који се шаље уз сваки захтев и самостално проверава потписом. Носи скуп информација о кориснику и омогућава праћење сесије без чувања стања на серверу.],
        [API _gateway_], [Јединствена улазна тачка микросервисног система која рутира захтеве ка одговарајућим сервисима.],
        [База података по сервису (енгл. _database per service_)], [Образац по коме сваки микросервис има приватне трајне податке доступне само преко свог API-ја.],
        [_Bucket_ (S3)], [Логичка јединица објектног складишта која групише објекте.],
        [_Docker Compose_], [Алат за заједнички опис и покретање више контејнера кроз `compose.yaml` датотеку са сервисима, мрежама и волуменима.],
        [_Docker_ слика (енгл. _image_)], [Непроменљив шаблон за покретање контејнера описан `Dockerfile` рецептом са корацима изградње.],
        [_Endpoint_], [Конкретна адреса HTTP API-ја са методом и путањом која излаже једну операцију сервера.],
        [_Handler_], [Функција за обраду захтева ка којој рутер усмерава захтев.],
        [_HttpOnly_ колачић], [Колачић недоступан скриптама на клијенту, чиме штити садржај (нпр. _refresh_ токен) од крађе путем скрипти на страни клијента.],
        [Контејнеризација (енгл. _containerization_)], [Паковање апликације са свим зависностима у изоловане контејнере који се једнако извршавају у сваком окружењу. Изолација се постиже на нивоу оперативног система.],
        [_Middleware_], [Компонента која обрађује захтев пре или после главне обраде.],
        [Микросервисна архитектура], [Стил у коме је систем скуп независно пуштаних сервиса груписаних око поддомена. Омогућава независан развој по сервису уз цену сложених дистрибуираних операција.],
        [Објектно складиште (енгл. _object storage_)], [Складиште које чува произвољне бинарне податке као објекте у _bucket_-има.],
        [Оптимистично закључавање (енгл. _optimistic locking_)], [Техника очувања интегритета код конкурентних измена провером верзије записа. Упис пролази само при поклапању верзије, иначе се пријављује конфликт.],
        [_Package by feature_], [Модел организације кода у коме су све датотеке једне функционалности у истом фолдеру. Структура одражава пословни домен уместо техничких слојева.],
        [_Presigned_ URL (унапред потписани URL)], [Унапред потписана адреса која привремено одобрава директан приступ објекту без проласка кроз сервис.],
        [_Refresh_ токен], [Дуготрајан JWT који служи само за издавање новог пара токена по истеку _access_ токена.],
        [_Reverse proxy_], [Посредник између клијента и сервера који прослеђује захтев у име клијента и скрива унутрашњу структуру система.],
        [Ротација токена (енгл. _token rotation_)], [Поступак у коме се при свакој употреби _refresh_ токена стари повлачи и издаје нов пар.],
        [Сандук (енгл. _crate_)], [Јединица компајлирања у _Rust_-у, бинарна или библиотечка.],
        [_Trait_], [_Rust_ концепт за дефинисање скупа метода које тип мора да имплементира, слично интерфејсу у другим језицима.],
        [_Zero trust_], [Безбедносни образац по принципу никада не веруј, увек провери. Сваки захтев се проверава без обзира на порекло.],
    ),
)
